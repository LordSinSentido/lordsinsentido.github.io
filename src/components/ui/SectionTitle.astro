---
interface Props {
  eyebrow: string;
  title: string;
  subtitle?: string;
}

const { eyebrow, title, subtitle } = Astro.props;
---

<div class="mb-12" data-reveal>
  <p class="mb-3 flex items-center gap-3 text-xs font-semibold uppercase tracking-[0.25em] text-accent">
    <span class="h-px w-8 bg-accent"></span>
    {eyebrow}
  </p>
  <h2 class="max-w-2xl font-display text-3xl font-medium tracking-tight text-ink sm:text-4xl">{title}</h2>
  {subtitle && <p class="mt-4 max-w-2xl text-muted">{subtitle}</p>}
</div>
