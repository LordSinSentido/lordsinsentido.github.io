---
import SectionTitle from '../ui/SectionTitle.astro';
---

<section id="education" class="scroll-mt-16 py-20">
  <div class="mx-auto max-w-4xl px-4 sm:px-6">
    <SectionTitle
      eyebrow="Education & Certifications"
      title="Education & certifications"
      subtitle="Formal education and credentials that support my experience."
    />

    <div data-render="education-grid">
      <div class="grid gap-x-10 gap-y-12 sm:grid-cols-2">
        <div class="border-t border-line pt-6">
          <span class="block h-5 w-40 rounded bg-surface-2"></span>
          <span class="mt-3 block h-4 w-56 rounded bg-surface-2"></span>
          <span class="mt-3 block h-4 w-full rounded bg-surface-2"></span>
        </div>
        <div class="hidden border-t border-line pt-6 sm:block">
          <span class="block h-5 w-40 rounded bg-surface-2"></span>
          <span class="mt-3 block h-4 w-56 rounded bg-surface-2"></span>
          <span class="mt-3 block h-4 w-full rounded bg-surface-2"></span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { hydrate, renderEducation } from '../../lib/render';

  hydrate('[data-render="education-grid"]', ({ education, certifications }) =>
    renderEducation(education, certifications),
  );
</script>
