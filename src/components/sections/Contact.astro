---
import SectionTitle from '../ui/SectionTitle.astro';
---

<section id="contact" class="scroll-mt-16 py-20">
  <div class="mx-auto max-w-4xl px-4 sm:px-6">
    <SectionTitle
      eyebrow="Contact"
      title="Let's connect"
      subtitle="For opportunities or questions, reach me at the address below."
    />

    <div data-render="contact-cta" data-reveal>
      <div class="flex flex-col items-start gap-6">
        <span class="inline-flex h-14 w-64 rounded-2xl bg-surface-2"></span>
        <div class="flex items-center gap-5">
          <span class="h-11 w-11 rounded-full bg-surface-2"></span>
          <span class="h-11 w-11 rounded-full bg-surface-2"></span>
          <span class="h-11 w-11 rounded-full bg-surface-2"></span>
        </div>
      </div>
    </div>
  </div>
</section>

<footer class="border-t border-line py-8">
  <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-3 px-4 text-sm text-muted sm:flex-row sm:px-6">
    <p>© 2026 Miguel Sosa. All rights reserved.</p>
    <p class="flex items-center gap-1.5">
      Built with Astro
      <span class="h-1 w-1 rounded-full bg-accent"></span>
      Tailwind
      <span class="h-1 w-1 rounded-full bg-accent"></span>
      Firebase
    </p>
  </div>
</footer>

<script>
  import { hydrate, renderContact } from '../../lib/render';

  hydrate('[data-render="contact-cta"]', ({ profile }) =>
    profile
      ? renderContact(profile)
      : '<p class="py-10 text-center text-sm text-muted">No profile data yet.</p>',
  );
</script>
